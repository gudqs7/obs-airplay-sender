diff --git a/internal/airplay/obs_external.go b/internal/airplay/obs_external.go
new file mode 100644
index 0000000..1d94d0e
--- /dev/null
+++ b/internal/airplay/obs_external.go
@@ -0,0 +1,49 @@
+package airplay
+
+import "time"
+
+// AccessUnitSource supplies timestamped Annex-B H.264 access units.
+// Implementations must return io.EOF after their input has been closed.
+type AccessUnitSource interface {
+	ReadVideoAccessUnit() (VideoAccessUnit, error)
+}
+
+// NewExternalVideoCapture adapts an external encoded-video source to the
+// capture surface consumed by MirrorSession.StreamFrames.
+func NewExternalVideoCapture(source AccessUnitSource) *ScreenCapture {
+	return &ScreenCapture{
+		frames:     source,
+		streamOnly: true,
+	}
+}
+
+// PCMFrameSource supplies interleaved stereo S16LE audio samples at 44.1 kHz.
+// The returned time identifies the first sample in dst.
+type PCMFrameSource interface {
+	ReadPCMFrame(dst []byte) (time.Time, error)
+}
+
+type externalPCMReader struct {
+	source PCMFrameSource
+}
+
+func (r *externalPCMReader) ReadPCMFrame(dst []byte) (time.Time, error) {
+	return r.source.ReadPCMFrame(dst)
+}
+
+// NewExternalAudioCapture adapts PCM supplied by an OBS audio callback to the
+// capture surface consumed by MirrorSession.StreamAudio.
+func NewExternalAudioCapture(codec AudioCodec, source PCMFrameSource) *AudioCapture {
+	return &AudioCapture{
+		codec:     codec,
+		pcmFrames: &externalPCMReader{source: source},
+	}
+}
+
+// VideoDimensions returns the canvas negotiated with the receiver.
+func (s *MirrorSession) VideoDimensions() (width, height int) {
+	if s == nil {
+		return 0, 0
+	}
+	return s.videoWidth, s.videoHeight
+}
